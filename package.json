{
  "name": "codeestra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:storage": "bun test packages/contracts/test packages/storage/test packages/git/test apps/runtime/test",
    "runtime": "bun run apps/runtime/src/main.ts",
    "codeestra": "bun run apps/cli/src/main.ts",
    "check": "bun run typecheck && bun run test && bun run test:storage"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "zod": "4.3.6"
  }
}
